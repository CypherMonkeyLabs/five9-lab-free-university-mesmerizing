          {
            "lane": "Net",
            "title": "Avoid",
            "detail": "A copied IP from the PDF is not a forever allow-list.",
            "frame": "ip"
          }
        ]
      },
      "quiz": [
        {
          "q": "A US Studio task belongs on",
          "choices": [
            "Any portal",
            "The US portal published for that region",
            "The Brazil portal by default",
            "A local HTML file"
          ],
          "answer": 1,
          "why": "The PDF splits portals by region."
        },
        {
          "q": "Old inferencecommunications.com hosts are",
          "choices": [
            "Invented",
            "Also listed in that PDF table",
            "Illegal",
            "Codecs"
          ],
          "answer": 1,
          "why": "They appear beside the studioportal names."
        },
        {
          "q": "DNS SRV is",
          "choices": [
            "Discouraged",
            "The preferred way to reach Five9 SIP resources, in that PDF",
            "A dialer mode",
            "A skill"
          ],
          "answer": 1,
          "why": "The PDF says so, and tells you IPs can change."
        },
        {
          "q": "Studio SIP ports in the PDF apply automatically to every VCC trunk. True or false?",
          "choices": [
            "True",
            "False. Confirm the SBC family",
            "True for analog headsets",
            "True for lists"
          ],
          "answer": 1,
          "why": "The notes sit with the Studio SBC section."
        },
        {
          "q": "Pinning one IP forever is",
          "choices": [
            "The PDF's advice",
            "The opposite of the DNS SRV note",
            "Required for QM",
            "Required for ANI"
          ],
          "answer": 1,
          "why": "Addresses change."
        }
      ],
      "cards": [
        {
          "front": "Region matters?",
          "back": "Yes. Use the matching portal."
        },
        {
          "front": "Legacy hosts listed?",
          "back": "Yes."
        },
        {
          "front": "How to find SIP?",
          "back": "DNS SRV."
        },
        {
          "front": "Paste Studio ports onto every trunk?",
          "back": "No. Confirm the family."
        }
      ],
      "lab": {
